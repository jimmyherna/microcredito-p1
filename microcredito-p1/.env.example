# Copiar a .env y ajustar valores locales. Node carga esto automáticamente
# solo si usan un paquete como dotenv; si no, exporten las variables en la
# terminal o pásenlas inline (ver README).

# Conexión a PostgreSQL (E2)
DATABASE_URL=postgres://credito_vecino:credito_vecino@localhost:5432/credito_vecino

# Ruta al paquete de datos canónico descomprimido (contiene eventos.jsonl)
CV_DATA_DIR=./datos/datos-proyecto-final

# Puerto de la API (E1)
PUERTO=3000

# memoria = arranca en RAM, sin Postgres (solo desarrollo): VACÍO si no hay CV_DATA_DIR
# (sin clientes/créditos de ejemplo) o con el paquete canónico si CV_DATA_DIR está definido.
# pg (o vacío) = usa DATABASE_URL. El video SIEMPRE se graba con pg.
REPO_MODO=pg

# RAG (E4) y chat con modelo de lenguaje (E5)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO_EMBEDDING=nomic-embed-text
# Modelo de CHAT (debe soportar "tools"/function calling). Recomendado:
# qwen2.5:7b (buen español). Si la laptop tiene poca RAM, usar llama3.2:3b.
OLLAMA_MODELO_CHAT=qwen2.5:7b

# Autenticación (usuarios reales por rol)
# Secreto para firmar los tokens de sesión (HMAC-SHA256, 12 h). Mínimo 16 caracteres; en producción
# genérelo aleatorio, p. ej.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si falta, la API usa un secreto de DESARROLLO y lo advierte en consola.
CV_SECRETO_SESION=Admin123!
# Código que debe escribir quien se registra con rol "gerencia" (se entrega sólo al Comité).
# Si falta, en desarrollo se acepta "comite-dev-2026" (con advertencia); con NODE_ENV=production
# no hay valor por defecto y nadie puede registrarse como gerencia hasta definirlo.
CV_CODIGO_GERENCIA=Admin123!

# Fecha de operación OPCIONAL (AAAA-MM-DD). Si NO se define, la API usa la fecha de hoy en Guatemala
# (UTC-6) cuando la petición no trae ?fechaCorte=. Útil para ensayar/grabar con una fecha fija.
# CV_FECHA_OPERACION=2026-10-31
