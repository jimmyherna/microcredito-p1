%% Diagrama de Secuencia — "Desembolsar credito"
%% Abrir/editar en https://mermaid.live (pegar este codigo)
sequenceDiagram
    actor Comite
    participant API as Contrato API
    participant UC as DesembolsarCredito (Caso de uso)
    participant Repo as RepositorioCreditos
    participant Politica as PoliticaCredito (vigente)
    participant Plan as PlanAmortizacionFactory
    participant Reloj as Reloj

    Comite->>API: POST /creditos/{id}/desembolsar
    API->>UC: ejecutar(comando)
    UC->>Repo: buscarPorId(id)
    Repo-->>UC: Credito (estado APROBADO)
    UC->>Reloj: hoy()
    Reloj-->>UC: fechaDesembolso
    UC->>Politica: obtenerVigente(fechaDesembolso)
    Politica-->>UC: {tna, tnaMoratoria, baseDeConteo, version}
    UC->>Credito: aplicarEvento(APROBADO, SE_DESEMBOLSA)
    Credito-->>UC: VIGENTE
    UC->>Plan: generarPlanAmortizacionFrances(capital, tasaMensual, n)
    Plan-->>UC: PlanAmortizacion (invariante: sum(amortizacion)=capital)
    UC->>Repo: guardar(Credito, Plan, politicaVersion)
    Repo-->>UC: ok
    UC-->>API: CreditoDesembolsado {id, plan}
    API-->>Comite: 200 OK
