%% Diagrama de Secuencia — "Registrar pago de cuota" (obligatorio, seccion 6.6)
%% Abrir/editar en https://mermaid.live (pegar este codigo)
sequenceDiagram
    actor Asesor
    participant API as Contrato API (Puerto primario)
    participant UC as RegistrarPago (Caso de uso)
    participant Repo as RepositorioCreditos (Puerto secundario)
    participant Credito as Credito (Agregado)
    participant Prelacion as PrelacionPago (Chain of Responsibility)
    participant Reloj as Reloj (Puerto secundario)
    participant Mayor as Movimiento (append-only)

    Asesor->>API: POST /pagos {creditoId, monto, claveIdempotencia}
    API->>UC: ejecutar(comando)
    UC->>Repo: buscarPorId(creditoId)
    Repo-->>UC: Credito
    UC->>Reloj: hoy()
    Reloj-->>UC: fechaCorte
    UC->>Credito: admitePago()?
    alt estado no admite pago (p.ej. SOLICITADO)
        Credito-->>UC: false
        UC-->>API: 409 TransicionInvalida
        API-->>Asesor: Error: pago no aplicable
    else estado admite pago
        Credito-->>UC: true
        UC->>Credito: calcularDeudaCuotaMasAntigua(fechaCorte)
        Credito-->>UC: DeudaCuota {gastos, moratorio, corriente, capital}
        UC->>Prelacion: aplicarPagoAPrelacion(monto, deuda)
        Prelacion-->>UC: ResultadoAplicacionPago {detalle, excedente, cuotaSaldada}
        opt excedente > 0
            UC->>UC: aplicarExcedente(excedente, politicaAdelanto)
        end
        UC->>Credito: aplicarEvento(EN_MORA, PAGA_TODO_LO_VENCIDO | PAGA_PARTE_DE_LO_VENCIDO)
        Credito-->>UC: nuevoEstado
        UC->>Mayor: registrar(movimientos, claveIdempotencia)
        Mayor-->>UC: ok (idempotente)
        UC->>Repo: guardar(Credito)
        Repo-->>UC: ok
        UC-->>API: ResultadoPago {desglose, nuevoEstado, tramo}
        API-->>Asesor: 200 OK
    end
