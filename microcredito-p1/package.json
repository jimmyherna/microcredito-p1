{
  "name": "microcredito-p1",
  "version": "1.0.0",
  "description": "Sistema de microcredito con asistente gerencial inteligente - Credito Vecino, S.A. - Proyecto Final, Analisis de Sistemas II (037)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/index.ts",
    "dev:api:memoria": "cross-env REPO_MODO=memoria tsx watch --env-file-if-exists=.env src/api/index.ts",
    "bd:subir": "docker compose up -d --wait",
    "bd:borrar": "docker compose down -v",
    "cargar": "tsx --env-file-if-exists=.env src/persistencia/cargador.ts",
    "ingesta:rag": "tsx --env-file-if-exists=.env src/rag/ingesta.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/servidor.ts",
    "build": "tsc -p tsconfig.json --outDir dist"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.12.0",
    "zod": "^4.5.2"
  }
}
